{
  "$description": "Neutral, generic, theme-able design tokens for the Design System Value Kit reporting surfaces (exec one-pager, team view, event ledger, leading feed, overlay). No brand. Primitives are mode-independent. Semantic color tokens carry a light value in $value and both modes explicitly in $extensions.mode, so a tool that builds Figma variable collections (or CSS custom properties) can create a light and a dark mode from one source. Swap the primitive ramps to rebrand; the semantic layer and every screen bound to it stay unchanged. DTCG-shaped (Design Tokens Community Group draft).",
  "$version": "0.1.0",
  "primitive": {
    "gray": {
      "50":  { "$type": "color", "$value": "#f8fafc" },
      "100": { "$type": "color", "$value": "#f1f5f9" },
      "200": { "$type": "color", "$value": "#e2e8f0" },
      "300": { "$type": "color", "$value": "#cbd5e1" },
      "400": { "$type": "color", "$value": "#94a3b8" },
      "500": { "$type": "color", "$value": "#64748b" },
      "600": { "$type": "color", "$value": "#475569" },
      "700": { "$type": "color", "$value": "#334155" },
      "800": { "$type": "color", "$value": "#1e293b" },
      "900": { "$type": "color", "$value": "#0f172a" },
      "950": { "$type": "color", "$value": "#020617" }
    },
    "accent": {
      "50":  { "$type": "color", "$value": "#eff6ff" },
      "100": { "$type": "color", "$value": "#dbeafe" },
      "200": { "$type": "color", "$value": "#bfdbfe" },
      "300": { "$type": "color", "$value": "#93c5fd" },
      "400": { "$type": "color", "$value": "#60a5fa" },
      "500": { "$type": "color", "$value": "#3b82f6" },
      "600": { "$type": "color", "$value": "#2563eb" },
      "700": { "$type": "color", "$value": "#1d4ed8" },
      "800": { "$type": "color", "$value": "#1e40af" },
      "900": { "$type": "color", "$value": "#1e3a8a" }
    },
    "green": {
      "400": { "$type": "color", "$value": "#4ade80" },
      "500": { "$type": "color", "$value": "#22c55e" },
      "600": { "$type": "color", "$value": "#16a34a" },
      "700": { "$type": "color", "$value": "#15803d" }
    },
    "amber": {
      "400": { "$type": "color", "$value": "#fbbf24" },
      "500": { "$type": "color", "$value": "#f59e0b" },
      "600": { "$type": "color", "$value": "#d97706" },
      "700": { "$type": "color", "$value": "#b45309" }
    },
    "red": {
      "400": { "$type": "color", "$value": "#f87171" },
      "500": { "$type": "color", "$value": "#ef4444" },
      "600": { "$type": "color", "$value": "#dc2626" },
      "700": { "$type": "color", "$value": "#b91c1c" }
    },
    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#000000" }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "12px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "semantic": {
    "$description": "Role tokens. $value is the light mode; $extensions.mode carries light and dark. Bind screens to these, never to primitives.",
    "color": {
      "bg":            { "$type": "color", "$value": "{primitive.gray.50}",  "$extensions": { "mode": { "light": "{primitive.gray.50}",  "dark": "{primitive.gray.950}" } } },
      "surface":       { "$type": "color", "$value": "{primitive.white}",    "$extensions": { "mode": { "light": "{primitive.white}",    "dark": "{primitive.gray.900}" } } },
      "surface-raised":{ "$type": "color", "$value": "{primitive.white}",    "$extensions": { "mode": { "light": "{primitive.white}",    "dark": "{primitive.gray.800}" } } },
      "text":          { "$type": "color", "$value": "{primitive.gray.900}", "$extensions": { "mode": { "light": "{primitive.gray.900}", "dark": "{primitive.gray.50}"  } } },
      "text-muted":    { "$type": "color", "$value": "{primitive.gray.600}", "$extensions": { "mode": { "light": "{primitive.gray.600}", "dark": "{primitive.gray.400}" } } },
      "text-subtle":   { "$type": "color", "$value": "{primitive.gray.500}", "$extensions": { "mode": { "light": "{primitive.gray.500}", "dark": "{primitive.gray.500}" } }, "$description": "Dimmest text role, for large text (>=18px or >=14px bold) or de-emphasized UI only. Its dark value sits at ~3.75:1, intentionally below the 4.5:1 body-text floor, so do not use it for normal body copy; use text-muted there." },
      "border":        { "$type": "color", "$value": "{primitive.gray.200}", "$extensions": { "mode": { "light": "{primitive.gray.200}", "dark": "{primitive.gray.800}" } }, "$description": "Decorative divider / card outline. Not a control boundary, so WCAG 1.4.11 (3:1) does not apply; use border-interactive for the visible edge of an unfocused control." },
      "border-strong": { "$type": "color", "$value": "{primitive.gray.300}", "$extensions": { "mode": { "light": "{primitive.gray.300}", "dark": "{primitive.gray.700}" } }, "$description": "Decorative emphasis divider (table rules, section splits). Decorative, 1.4.11-exempt." },
      "border-interactive": { "$type": "color", "$value": "{primitive.gray.500}", "$extensions": { "mode": { "light": "{primitive.gray.500}", "dark": "{primitive.gray.400}" } }, "$description": "Visible boundary of an unfocused interactive control (input, select, toggle). Meets 1.4.11 3:1 against surface; contrast-gated." },
      "accent":        { "$type": "color", "$value": "{primitive.accent.600}", "$extensions": { "mode": { "light": "{primitive.accent.600}", "dark": "{primitive.accent.400}" } } },
      "accent-hover":  { "$type": "color", "$value": "{primitive.accent.700}", "$extensions": { "mode": { "light": "{primitive.accent.700}", "dark": "{primitive.accent.300}" } } },
      "on-accent":     { "$type": "color", "$value": "{primitive.white}",    "$extensions": { "mode": { "light": "{primitive.white}",    "dark": "{primitive.gray.950}" } } },
      "focus":         { "$type": "color", "$value": "{primitive.accent.600}", "$extensions": { "mode": { "light": "{primitive.accent.600}", "dark": "{primitive.accent.400}" } } },
      "success":       { "$type": "color", "$value": "{primitive.green.700}", "$extensions": { "mode": { "light": "{primitive.green.700}", "dark": "{primitive.green.400}" } } },
      "warning":       { "$type": "color", "$value": "{primitive.amber.700}", "$extensions": { "mode": { "light": "{primitive.amber.700}", "dark": "{primitive.amber.400}" } } },
      "danger":        { "$type": "color", "$value": "{primitive.red.700}",   "$extensions": { "mode": { "light": "{primitive.red.700}",   "dark": "{primitive.red.400}"   } } }
    }
  },
  "$meta": {
    "modes": ["light", "dark"],
    "note": "Rebrand contract: replace primitive.accent.* to change the accent; replace primitive.gray.* to change the neutral. Every text-on-surface pair is contrast-checked in tokens/contrast-report.md; do not change a semantic value without re-running tokens/check-contrast.py. This token package versions independently of the kit.",
    "on-accent-large-only": false
  }
}
