{
  "note": "Generic screen-data-binding contract for the four value-surface screens. Each text slot maps to a source (a metric id M1..M9, a value-ledger element, an event, a team row, a feed item, a design-system field, or `static` chrome) and a template. No node ids live here: the contract is generic across any target file. The per-file node ids are in screen-census.json; the two join on the slot id. populate_screens.py reads this file plus a data payload and emits a resolved {slot: string} map. A slot whose template references a payload path the run does not supply renders a visible placeholder and is reported as a run-time source-gap; it never invents a number. No slot is permanently unbound: every slot maps to a source, and a gap is a property of a given payload, not of the contract.",
  "generated": "2026-09-08",
  "template_syntax": {
    "token": "{dot.path|format} substitutes payload[dot][path] formatted; array indices are numeric segments (teams.0.coverage).",
    "optional": "{dot.path?} or {dot.path?|format} renders '' when the value is absent or empty (no gap flagged). Without '?', an absent, null, or empty value renders the placeholder and flags the slot as a run-time source-gap.",
    "formats": {
      "pct1": "number -> one-decimal percent, e.g. 54.7 -> '54.7%'",
      "pct0": "number -> integer percent, e.g. 75 -> '75%'",
      "pts_signed": "number -> signed points, e.g. 5.2 -> '+5.2 pts', -1.2 -> '−1.2 pts'",
      "str": "value -> str(value) (default when no format is given)"
    },
    "placeholder": "the resolver's configured gap marker (default '—'); every gap slot is also listed in the resolved output's source_gaps."
  },
  "bindings": [
